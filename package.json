{
  "name": "forgottenbranches",
  "version": "1.0.3",
  "description": "Find and clean up abandoned local git branches",
  "private": false,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "main": "./dist/cli.js",
  "bin": {
    "forgottenbranches": "bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "keywords": [
    "git",
    "branches",
    "cleanup",
    "cli",
    "terminal",
    "tui",
    "ink"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulfdeztdo/forgottenbranches.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:server": "pnpm --filter forgottenbranches-server run dev",
    "dev:client": "pnpm --filter forgottenbranches-client run dev",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "build:shared": "pnpm --filter @forgottenbranches/types run build",
    "build:client": "pnpm --filter forgottenbranches-client run build",
    "build:server": "pnpm --filter forgottenbranches-server run build",
    "build:dist": "tsup && node -e \"import { cpSync, existsSync } from 'fs'; if(existsSync('client/dist')) cpSync('client/dist', 'dist/public', {recursive:true})\"",
    "build": "pnpm run build:shared && pnpm run build:client && pnpm run build:dist",
    "prepublishOnly": "pnpm run build",
    "start": "pnpm --filter forgottenbranches-server run start",
    "install:all": "pnpm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "concurrently": "^9.1.0",
    "react-devtools-core": "^7.0.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.7"
  },
  "dependencies": {}
}
